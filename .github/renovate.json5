{
  // Merged over the central config in eclipse-score/cicd-workflows (.github/renovate.json5).
  packageRules: [
    {
      // Lift the central "<=1.1.0" cap; persistency is already on score_tooling 3.x.
      matchManagers: ["bazel-module"],
      matchPackageNames: ["score_tooling"],
      allowedVersions: "*",
    },
  ],
}
