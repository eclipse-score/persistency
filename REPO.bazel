# The injected flags come after a target's own copts, so enabling the warning levels globally
# would defeat the `-w` and `-Wno-error` opt-outs of third-party code. Only levels belong here;
# a REPO.bazel travels with the sources, so `warnings_as_errors` stays in .bazelrc.
repo(features = [
    "minimal_warnings",
])

# `ignore_directories()` keeps Bazel's convenience symlinks and Cargo's build directory out of package lookup and `glob()`.
# `.bazelignore` only affects target-pattern expansion such as `//...`.
# `ignore_directories()` also stops `glob()` from following the `bazel-*` symlinks into the output base.
ignore_directories([
    "bazel-*",
    "target",
])
