# ============================================================================
# LLVM source-based coverage (Linux, Clang + Ferrocene) — unified Rust + C++
# ============================================================================
# Use with: bazel coverage --config=llvm_cov //score/... --build_tests_only
#
# IMPORTANT: do NOT combine with --config=per-x86_64-linux. That config appends
# the GCC --extra_toolchains AFTER the LLVM one and GCC would win toolchain
# resolution, producing no covmap data. The llvm_cov config runs on the plain
# host platform with the hermetic Clang toolchain below.
#
# Uses LLVM's source-based coverage instrumentation (--experimental_use_llvm_covmap)
# with a custom merger/reporter that produce HTML reports via llvm-cov directly.
#
# NOTE: --experimental_use_llvm_covmap causes Bazel to instrument ALL targets.
# Source filtering is handled at report time by the reporter using the coverage
# allowlist generated by the score_coverage_scope target.
# See @score_tooling//coverage (COVERAGE_GUIDE.md) for details.

coverage:llvm_cov --nocache_test_results
coverage:llvm_cov --cxxopt=-O0
coverage:llvm_cov --combined_report=lcov
coverage:llvm_cov --experimental_fetch_all_coverage_outputs

# By default Bazel creates for each library a *.so for its tests. If there is a header that is used by multiple *.so files
# and these *.so files have different instrumentation (production code has, test has not) a conflict arises which one to use when calculating coverage.
# Then the first object is used, and it is pure luck if it contains the correct data or not. Even worse, small changes can change the order and then lead
# to big coverage gaps. All these problems do not arise if no dynamic libs are used. Thus, we rather take bigger build times and binaries in advance for correct data.
coverage:llvm_cov --dynamic_mode=off

coverage:llvm_cov --experimental_generate_llvm_lcov
coverage:llvm_cov --experimental_use_llvm_covmap
coverage:llvm_cov --extra_toolchains=@llvm_toolchain//:cc-toolchain-x86_64-linux
# Rust needs no coverage-specific toolchain: the standard
# @score_toolchains_rust//toolchains/ferrocene toolchain registered in the
# root .bazelrc ships with llvm-cov/llvm-profdata attached (>= 0.10.0), and
# rules_rust instruments crates under `bazel coverage` whenever the
# rust_toolchain declares llvm_cov.

# Use llvm-cov directly for HTML report generation instead of genhtml/lcov.
# The merger (per-test: profraw -> profdata + metadata) lives in score_tooling;
# the reporter_wrapper (final combined report) is instantiated in
# //quality/coverage:BUILD because it carries this repo's coverage scope and
# LLVM tool labels.
coverage:llvm_cov --coverage_output_generator=@score_tooling//coverage:merger
coverage:llvm_cov --coverage_report_generator=//quality/coverage:reporter_wrapper

# Override GENERATE_LLVM_LCOV to keep raw profraw files instead of converting to LCOV.
# The custom merger handles profraw→profdata directly.
coverage:llvm_cov --test_env=GENERATE_LLVM_LCOV=0
# Suppress the default gcov path since we use llvm-cov directly.
coverage:llvm_cov --test_env=COVERAGE_GCOV_PATH=/usr/bin/true

# These compile time options are required to cover abnormal termination cases. In GCC one can use `__gcc_dump()`, but this does not work with LLVM.
# LLVM provides these compile-time options in combination with a specific profile setting which is enabled in bazel via `LLVM_PROFILE_CONTINUOUS_MODE`.
coverage:llvm_cov --test_env=LLVM_PROFILE_CONTINUOUS_MODE=1
coverage:llvm_cov --features=enable_llvm_coverage_for_death_tests
# Rust equivalent of the enable_llvm_coverage_for_death_tests cc_feature:
# continuous-mode profiling (%c in LLVM_PROFILE_FILE) requires runtime counter
# relocation, otherwise the profile runtime errors out and writes no .profraw
# ("Neither __llvm_profile_counter_bias nor __llvm_profile_bitmap_bias is defined").
coverage:llvm_cov --@rules_rust//rust/settings:extra_rustc_flag=-Cllvm-args=-runtime-counter-relocation

# Under the LLVM toolchain the `coverage` feature expands to
# -fprofile-instr-generate -fcoverage-mapping — exactly the covmap
# instrumentation this pipeline needs. Enable it explicitly (the root
# .bazelrc no longer carries a global `coverage --features=coverage` line).
coverage:llvm_cov --features=coverage

# Keep unlinked functions in the coverage map so unreferenced code shows as
# uncovered instead of vanishing (parity with the old ferrocene-coverage config).
coverage:llvm_cov --@rules_rust//rust/settings:extra_rustc_flag=-Clink-dead-code

# Enable branch coverage instrumentation for Rust. NOTE: -Z flags are
# unstable rustc options; they work here because the Ferrocene toolchain in
# use is a rolling (nightly-based) build (rustc 1.94.0-nightly, Ferrocene
# rolling). If the repo ever pins a stable-channel Ferrocene release, this
# flag will be rejected and must be dropped (losing the Rust branch column)
# until branch coverage stabilizes.
coverage:llvm_cov --@rules_rust//rust/settings:extra_rustc_flag=-Zcoverage-options=branch

# Disable warnings-as-errors for coverage builds. External deps (score_baselibs)
# request the treat_warnings_as_errors feature, which the LLVM toolchain expands
# to -Werror; Clang 22 emits warnings (e.g. -Wdeprecated-declarations) that the
# GCC 12 toolchain of regular builds does not, and coverage runs must not fail
# on instrumentation-unrelated warnings in third-party code.
# --host_features covers the exec configuration: Bazel builds the coverage
# report generator (reporter_wrapper -> coverage_scope -> scope deps) as a
# tool, which compiles the scope's cc deps in the exec config.
coverage:llvm_cov --features=-treat_warnings_as_errors
coverage:llvm_cov --host_features=-treat_warnings_as_errors
