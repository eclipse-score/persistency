# Do not use automatically C++ generated toolchains
build --action_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1

common --registry=https://raw.githubusercontent.com/eclipse-score/bazel_registry/main/
common --registry=https://bcr.bazel.build

# Tolerate flaky downloads (e.g. snapshot.ubuntu.com)
common --experimental_repository_downloader_retries=10
common --experimental_scale_timeouts=2.0
common --http_connector_attempts=10
common --http_connector_retry_max_timeout=1s
common --http_timeout_scaling=2.0

# Credentials for the QNX SDP downloads.
# `common` (not `build`) makes query and mod authenticate too.
# The helper logs in to qnx.com, which can take longer than the 10s default timeout.
common --credential_helper=*.qnx.com=%workspace%/.github/tools/qnx_credential_helper.py
common --credential_helper_timeout="60s"

build --java_language_version=17
build --tool_java_language_version=17
build --java_runtime_version=remotejdk_17
build --tool_java_runtime_version=remotejdk_17
# Warning features come from @score_cpp_policies, injected in MODULE.bazel. The levels are
# enabled in REPO.bazel; `warnings_as_errors` is enabled here, because an rc file is read for
# the root module only and so keeps `-Werror` out of the builds of consumers of this module.
build --features=warnings_as_errors
build --incompatible_strict_action_env

# Persistency-specific settings
build --sandbox_writable_path=/var/tmp
build --@score_baselibs//score/log_rust:safety_level=qm
build --@score_logging//score/mw/log/flags:KRemote_Logging=False
# Miri toolchain for //score/kvs/rust_kvs:unit_tests_miri*.
# It has its own toolchain type, so it doesn't compete with the ferrocene toolchain registered in score_toolchain.bazelrc.
build:score-linux-x86_64 --extra_toolchains=@score_toolchains_rust//toolchains/ferrocene:ferrocene_x86_64_unknown_linux_gnu_miri

# CodeQL C++ analysis: --config=codeql
# CodeQL traces compiler calls with LD_PRELOAD, which the statically linked S-CORE GCC ignores.
# The hermetic Clang of the coverage toolchain is dynamically linked, so CodeQL can trace it.
# The platform has no gcc_12.2.0 constraint, so the S-CORE GCC is not selected.
# Clang rejects the GCC-only warning flags under -Werror, so warnings stay warnings, as in coverage.
# Local spawns without action cache, so that CodeQL sees every compiler call.
build:codeql --platforms=@score_bazel_platforms//:x86_64-linux
build:codeql --host_platform=@score_bazel_platforms//:x86_64-linux
build:codeql --extra_toolchains=@llvm_toolchain//:cc-toolchain-x86_64-linux
build:codeql --features=-warnings_as_errors --host_features=-warnings_as_errors
build:codeql --features=-treat_warnings_as_errors --host_features=-treat_warnings_as_errors
build:codeql --spawn_strategy=local
build:codeql --nouse_action_cache
build:codeql --noremote_accept_cached
build:codeql --noremote_upload_local_results

test --test_output=errors

# Import platform and toolchain configurations. Not try-import: these files are required.
import %workspace%/score.bazelrc/score_toolchain.bazelrc

# Test execution and compatibility settings for this repository.
test:_score_common --build_tests_only

# Target configuration for CPU:x86-64|OS:Linux build (do not use it in case of system toolchains!)
test:score-linux-x86_64 --config=_score_common

# Target configuration for CPU:x86-64|OS:QNX build (do not use it in case of system toolchains!)
test:score-qnx-x86_64 --config=_score_common

# Target configuration for CPU:AArch64|OS:QNX build (do not use it in case of system toolchains!)
test:score-qnx-aarch64 --config=_score_common

# Deprecated aliases for the previous config names.
# `test` inherits `build:` entries, so the aliased config's `test:` entries are pulled in too.
build:per-x86_64-linux --config=score-linux-x86_64
build:per-x86_64-qnx --config=score-qnx-x86_64
build:per-arm64-qnx --config=score-qnx-aarch64

# Import sanitizer configurations
import %workspace%/score.bazelrc/score_sanitizers.bazelrc

# Import linter configurations: --config=lint (clang-tidy, clippy, ruff)
import %workspace%/score.bazelrc/score_lint.bazelrc

# LLVM source-based coverage (C++ + Rust): --config=llvm_cov
import %workspace%/tools/coverage/coverage.bazelrc

# Import custom user settings, e.g. to enable sanitizers without touching the main .bazelrc
try-import %workspace%/user.bazelrc
